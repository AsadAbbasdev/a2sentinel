@"
# Environment files
backend/.env
frontend/.env.local
frontend/.env

# Python
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc

# Node
frontend/node_modules/
frontend/.next/

# Database
*.db
*.sqlite3

# Logs
*.log
logs/
"@ | Set-Content -Path ".gitignore" -Encoding UTF8