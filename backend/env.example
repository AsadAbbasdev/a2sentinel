# ════════════════════════════════════════════
#   A2 Sentinel — Environment Variables
# ════════════════════════════════════════════

# ─── App ────────────────────────────────────
APP_NAME=A2 Sentinel
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# ─── Security ───────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/a2_sentinel
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/a2_sentinel

# ─── Redis ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── AI Provider ────────────────────────────
# ABHI: "groq" use karo (FREE)
# BAAD MEIN: "anthropic" kar do jab revenue aaye
AI_PROVIDER=groq

# Groq Free API Key — groq.com se lo (bilkul free)
GROQ_API_KEY=gsk_tumhari_groq_key_yahan
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (abhi khali rehne do)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-5
AI_MAX_TOKENS=4096

# ─── Rate Limiting ──────────────────────────
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=200

# ─── CORS ───────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
